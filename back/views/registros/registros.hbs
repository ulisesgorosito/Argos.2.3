<link rel="stylesheet" href="/stylesheets/style.css">

<div class="crud-page">

    <div class="page-header">
        <h1>Registros</h1>

        <div>
            <a class="btn btn-primary" href="/registros/agregar">
                Nuevo Registro
            </a>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Autor</th>
                <th>Título</th>
                <th>Subtítulo</th>
                <th>Fecha de publicación</th>
                <th>Editorial</th>
            </tr>
        </thead>

        <tbody>
            {{#each registro}}
            <tr>
                <td>{{autor}}</td>
                <td>{{titulo}}</td>
                <td>{{subtitulo}}</td>
                <td>{{fecha_publicacion}}</td>
                <td>{{editorial}}</td>
            </tr>
            {{else}}
            <tr>
                <td colspan="5" class="text-center text-muted">
                    No hay registros creados
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

</div>