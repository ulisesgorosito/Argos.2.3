<link rel="stylesheet" href="/stylesheets/style.css">

<div class="crud-page">

<div class="page-header">
    <h1>Nueva Autoría</h1>

<a href="/registros" class="btn btn-secondary">
    Volver
</a>

</div>

{{#if error}} <div class="alert alert-danger">
{{message}} </div>
{{/if}}

<form class="crud-form" action="/autorias/agregar" method="post">

<div class="form-group">
    <label for="nombre">
        Nombre
    </label>

    <input
        type="text"
        id="nombre"
        name="nombre"
        placeholder="Ej: Jorge Luis"
        required
    >
</div>

<div class="form-group">
    <label for="apellido">
        Apellido
    </label>

    <input
        type="text"
        id="apellido"
        name="apellido"
        placeholder="Ej: Borges"
        required
    >
</div>

<div class="form-group">
    <label for="fecha_nacimiento">
        Fecha de nacimiento
    </label>

    <input
        type="date"
        id="fecha_nacimiento"
        name="fecha_nacimiento"
    >
</div>

<div class="form-group">
    <label for="fecha_muerte">
        Fecha de muerte
    </label>

    <input
        type="date"
        id="fecha_muerte"
        name="fecha_muerte"
    >
</div>

<button type="submit" class="btn btn-primary">
    Agregar autoría
</button>

</form>

</div>
