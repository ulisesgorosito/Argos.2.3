<div class="container" style="margin:100px 0">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Editar tema</h4>
            <form action="/temas/editar/{{tema.id}}" method="post">
                <input type="hidden" name="id" value="{{tema.id}}">

                <div class="mb-3 row">
                    <label for="nombre">Nombre</label>
                    <input type="text" class="form-control" name="nombre" id="nombre" value="{{tema.nombre}}">
                </div>

                <div class="mb-3 row">
                    <label for="descripcion">
                        Descripción
                        <span class="text-muted">(opcional)</span>
                    </label>
                    <textarea name="descripcion" id="descripcion" class="form-control" placeholder="Escribí una breve descripción del tema...">{{tema.descripcion}}</textarea>
                </div>

                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </form>

            {{#if error}}
                <p class="text-danger">{{message}}</p>
            {{/if}}
        </div>
    </div>
</div>