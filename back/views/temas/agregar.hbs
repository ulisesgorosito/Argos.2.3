<link rel="stylesheet" href="/stylesheets/style.css">

<div class="crud-page">

    <div class="page-header">
        <h1>Nuevo tema</h1>

        <a href="/temas" class="btn btn-secondary">
            Volver
        </a>
    </div>

    {{#if error}}
        <div class="alert alert-danger">
            {{message}}
        </div>
    {{/if}}

    <form class="crud-form" action="/temas/agregar" method="post">

        <div class="form-group">
            <label for="nombre">Nombre</label>

            <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Ej: Filosofía"
                required
            >
        </div>

        <div class="form-group">
            <label for="descripcion">
                Descripción
                <span>(opcional)</span>
            </label>

            <textarea
                id="descripcion"
                name="descripcion"
                placeholder="Escribí una breve descripción del tema..."
            ></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Agregar tema
        </button>

    </form>

</div>