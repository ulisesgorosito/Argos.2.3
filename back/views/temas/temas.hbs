<link rel="stylesheet" href="/stylesheets/style.css">

<div class="crud-page">

<div class="page-header">
    <h1>Temas</h1>

    <a class="btn btn-primary" href="/temas/agregar">
        Nuevo tema
    </a>
</div>

<table class="data-table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        {{#each temas}}
        <tr>
            <td>{{nombre}}</td>
            <td>{{descripcion}}</td>
            <td class="actions">
                <a href="/temas/editar/{{id}}" class="btn-action btn-edit" title="Editar">
                    <i class="bi bi-pencil"></i>
                </a>

                <a href="/temas/eliminar/{{id}}" class="btn-action btn-delete" title="Eliminar">
                    <i class="bi bi-trash"></i>
                </a>
            </td>
        </tr>
        {{else}}
        <tr>
            <td colspan="3" class="text-center text-muted">
                No hay temas creados
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>
</div>
